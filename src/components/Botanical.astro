---
/**
 * A succulent rosette, seen from above, used as an edge accent.
 *
 * The artwork itself lives in public/marks/succulent-<tone>.svg, one
 * file per colourway. It was drawn the way the plant grows: leaf i sits
 * 137.5 degrees round the stem from leaf i-1 and a little further in,
 * so every leaf lands in the gap between the two before it, outermost
 * drawn first and the centre last. Each leaf is a teardrop carrying a
 * gradient down its own length, dark where it meets the middle of the
 * plant and finishing on a vivid tip, with two narrower copies of its
 * own shape inside it in darker tones, because the leaf cups upward and
 * that hollow reads as shadow from this angle.
 *
 * It is referenced rather than inlined because the geometry is
 * identical every time and only the colourway changes: inline, twelve
 * of these put 1.7MB of path data into the page. As files they are
 * about 14KB each over the wire and the browser caches them.
 *
 * Props:
 *   corner  - "tl" | "tr" | "bl" | "br"   which edge it breaks
 *   tone    - mint | deep | pale | sage | blush | amber | plum
 *   scale   - size multiplier
 *   opacity - 0..1
 *   rotate  - degrees, so no two sit at the same angle
 *   show    - "peek" | "half" | "full", how far onto the page it comes
 */
const {
  corner = 'bl', tone = 'mint', scale = 1,
  opacity = 0.3, rotate = 0, show = 'peek',
} = Astro.props;

/* A fraction of the plant's OWN width. A percentage in the offset would
   resolve against the section instead and throw it off the page. */
const inset = { peek: -0.62, half: -0.34, full: -0.06 }[show] ?? -0.62;
---

<div
  class:list={['bot', `bot--${corner}`]}
  style={`--bot-scale:${scale}; --bot-opacity:${opacity}; --bot-rotate:${rotate}deg; --bot-inset:${inset};`}
  aria-hidden="true"
>
  <img src={`/marks/succulent-${tone}.svg`} alt="" width="370" height="370" loading="lazy" />
</div>

<style>
  .bot {
    --bot-w: calc(200px * var(--bot-scale));
    position: absolute;
    width: var(--bot-w);
    pointer-events: none;
    opacity: var(--bot-opacity);
    transform: rotate(var(--bot-rotate));
    z-index: 0;
  }
  .bot img { display: block; width: 100%; height: auto; }

  .bot--bl, .bot--br { bottom: calc(var(--bot-w) * var(--bot-inset)); }
  .bot--tl, .bot--tr { top:    calc(var(--bot-w) * var(--bot-inset)); }
  .bot--tl, .bot--bl { left:   calc(var(--bot-w) * var(--bot-inset)); }
  .bot--tr, .bot--br { right:  calc(var(--bot-w) * var(--bot-inset)); }

  @media (max-width: 40rem) { .bot { --bot-w: calc(150px * var(--bot-scale)); } }
</style>
