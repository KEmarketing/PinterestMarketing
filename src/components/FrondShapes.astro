---
/* The shared frond paths, drawn once and hidden. Every frond on the page
   points at these by id, so the page carries one copy of the geometry
   instead of one per frond. */
import { bands, ids } from './frond-shapes.mjs';
---
<svg width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden" aria-hidden="true" focusable="false">
  <defs>
    {bands.map((band, i) => (
      <>
        <path id={ids.silhouette(i)} d={band.silhouette} />
        <path id={ids.stem(i)} d={band.stem} />
        {band.leaves.map((l, j) => (
          <>
            <path id={ids.leaf(i, j)} d={l.d} />
            <path id={ids.veins(i, j)} d={l.veins} />
          </>
        ))}
      </>
    ))}
  </defs>
</svg>
