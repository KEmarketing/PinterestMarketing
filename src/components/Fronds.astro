---
/**
 * Fronds: the site's signature motion.
 *
 * Fronds are ROOTED OFF-SCREEN at the edges, so they read as a frame
 * growing into the page rather than clip-art floating in space.
 * They sway on slow, offset cycles. On scroll a short "gust" raises
 * the sway amplitude and then decays, so the page feels breathed on
 * rather than animated at.
 *
 * Frozen at rest for anyone with reduced motion turned on.
 *
 * Props:
 *   corner  - "tl" | "tr" | "bl" | "br"   which edge it grows from
 *   scale   - visual size multiplier (default 1)
 *   tone    - "mint" | "deep" | "pale"    which green
 *   delay   - seconds, to offset its sway from its neighbours
 */
const {
  corner = 'tl',
  scale = 1,
  tone = 'mint',
  delay = 0,
  blur = 0,
  opacity = 1,
} = Astro.props;

import { bands, ids } from './frond-shapes.mjs';


/* Each tone carries four values, because a flat silhouette reads as a
   sticker. The blades get a gradient from base to tip, the two sides of
   the rachis differ slightly so one reads as turned away from the light,
   and a darker offset copy sits behind the whole frond as its shadow. */
const tones = {
  mint:  { fill: '#B8E0D0', lit: '#D6EFE4', dark: '#8FC7B2', stem: '#8FC7B2', shade: '#5E9A83' },
  deep:  { fill: '#8FC7B2', lit: '#B4DCC9', dark: '#6FAE97', stem: '#6FAE97', shade: '#4A8770' },
  pale:  { fill: '#D8F0E8', lit: '#EEFBF6', dark: '#B8E0D0', stem: '#B8E0D0', shade: '#8FC7B2' },
};
const c = tones[tone] || tones.mint;
const uid = 'f' + Math.random().toString(36).slice(2, 8);
---

<div
  class:list={['frond', `frond--${corner}`]}
  style={`--frond-scale:${scale}; --frond-delay:${delay}s; --frond-blur:${blur}px; --frond-opacity:${opacity}; --frond-shade:${c.shade}55;`}
  aria-hidden="true"
>
  <svg viewBox="-60 -380 560 440" class="frond__svg" role="presentation" focusable="false">
    <defs>
      <linearGradient id={`${uid}-a`} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" stop-color={c.dark} />
        <stop offset="55%" stop-color={c.fill} />
        <stop offset="100%" stop-color={c.lit} />
      </linearGradient>
      <linearGradient id={`${uid}-b`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color={c.shade} />
        <stop offset="60%" stop-color={c.dark} />
        <stop offset="100%" stop-color={c.fill} />
      </linearGradient>
    </defs>
    <g class="frond__pivot">
      {/* The frond is translucent, so the lattice behind the panel read
          straight through it. This is the same shape painted solid in
          the panel's own colour first, which blocks it. It sits inside
          the pivot so it sways with everything else. */}
      <g class="frond__back">
        {bands.map((band, i) => (
          <g>
            <use href={`#${ids.silhouette(i)}`} />
            <use href={`#${ids.stem(i)}`} fill="none" stroke-width={[3.2, 2.9, 2.5][i]} stroke-linecap="round" />
          </g>
        ))}
      </g>
      <g class="frond__art">
      {/* The frond bends in three nested sections, so the tip travels
          further than the base, and the stem is drawn in matching pieces
          inside those sections, which keeps the leaves welded to it.
          Each section's shadow sits inside its own joint, so it is under
          the exact same transform as the leaves it belongs to and cannot
          be left behind. Every shadow is drawn before every leaf, which
          is why the child joint comes between them: without that, a
          section's shadow painted over the section below it. */}
        <g class="frond__joint" style={`transform-origin:${bands[0].ox.toFixed(1)}px ${bands[0].oy.toFixed(1)}px;`}>
          <g class="frond__cast" transform="translate(3 4)">
            <use href={`#${ids.stem(0)}`} fill="none" stroke={c.shade} stroke-width="2.4" stroke-linecap="round" stroke-opacity="0.20" />
            <use href={`#${ids.silhouette(0)}`} fill={c.shade} fill-opacity="0.20" />
          </g>
          <g class="frond__joint" style={`transform-origin:${bands[1].ox.toFixed(1)}px ${bands[1].oy.toFixed(1)}px;`}>
            <g class="frond__cast" transform="translate(3 4)">
              <use href={`#${ids.stem(1)}`} fill="none" stroke={c.shade} stroke-width="2.1" stroke-linecap="round" stroke-opacity="0.20" />
              <use href={`#${ids.silhouette(1)}`} fill={c.shade} fill-opacity="0.20" />
            </g>
            <g class="frond__joint" style={`transform-origin:${bands[2].ox.toFixed(1)}px ${bands[2].oy.toFixed(1)}px;`}>
              <g class="frond__cast" transform="translate(3 4)">
                <use href={`#${ids.stem(2)}`} fill="none" stroke={c.shade} stroke-width="1.7" stroke-linecap="round" stroke-opacity="0.20" />
                <use href={`#${ids.silhouette(2)}`} fill={c.shade} fill-opacity="0.20" />
              </g>
              <use href={`#${ids.stem(2)}`} fill="none" stroke={c.stem} stroke-width="1.7" stroke-linecap="round" />
              {bands[2].leaves.map((l, j) => (
                <g><use href={`#${ids.leaf(2, j)}`} fill={`url(#${uid}-${l.side === 1 ? 'b' : 'a'})`} />
                   <use href={`#${ids.veins(2, j)}`} fill="none" stroke={c.shade} stroke-width="0.7" opacity="0.30" stroke-linecap="round" /></g>
              ))}
            </g>
            <use href={`#${ids.stem(1)}`} fill="none" stroke={c.stem} stroke-width="2.1" stroke-linecap="round" />
            {bands[1].leaves.map((l, j) => (
              <g><use href={`#${ids.leaf(1, j)}`} fill={`url(#${uid}-${l.side === 1 ? 'b' : 'a'})`} />
                 <use href={`#${ids.veins(1, j)}`} fill="none" stroke={c.shade} stroke-width="0.7" opacity="0.30" stroke-linecap="round" /></g>
            ))}
          </g>
          <use href={`#${ids.stem(0)}`} fill="none" stroke={c.stem} stroke-width="2.4" stroke-linecap="round" />
          {bands[0].leaves.map((l, j) => (
            <g><use href={`#${ids.leaf(0, j)}`} fill={`url(#${uid}-${l.side === 1 ? 'b' : 'a'})`} />
               <use href={`#${ids.veins(0, j)}`} fill="none" stroke={c.shade} stroke-width="0.7" opacity="0.30" stroke-linecap="round" /></g>
          ))}
        </g>
    </g>
  </svg>
</div>

<style>
  .frond {
    position: absolute;
    width: calc(300px * var(--frond-scale));
    pointer-events: none;
    filter: blur(var(--frond-blur));
    z-index: 0;
  }

  .frond__svg { width: 100%; height: auto; overflow: visible; }

  /* The opaque backing takes the panel colour; only the artwork above it
     is translucent, so the frond fades into the panel and not into
     whatever is painted on the panel. */
  .frond__back use { fill: var(--panel-bg, transparent); stroke: var(--panel-bg, transparent); }
  .frond__art { opacity: var(--frond-alpha, var(--frond-opacity)); }

  /* Root each frond just past the edge so no cut stem is visible */
  /* Rooted well outside the panel so the edge crops the frond, which is
     what makes it read as one big leaf rather than a whole small one. */
  .frond--tl { top: -34%;    left: -30%;  transform: rotate(12deg); }
  .frond--tr { top: -34%;    right: -30%; transform: scaleX(-1) rotate(12deg); }
  .frond--bl { bottom: -34%; left: -30%;  transform: scaleY(-1) rotate(12deg); }
  .frond--br { bottom: -34%; right: -30%; transform: scale(-1, -1) rotate(12deg); }

  /* --- the breeze ------------------------------------------- */
  .frond__pivot {
    transform-origin: 0px 0px;   /* pivot at the root, like a real stem */
    transform-box: view-box;
    animation: sway var(--breeze-base) ease-in-out infinite;
    animation-delay: calc(-1 * var(--frond-delay));
  }

  @keyframes sway {
    0%, 100% { transform: rotate(calc(-1.6deg * var(--gust-mult, 1))); }
    50%      { transform: rotate(calc(2.4deg * var(--gust-mult, 1))); }
  }

  /* Leaflets flutter a touch out of phase with the stem, which is
     what stops it reading as one flat shape rotating. */
  /* Each section of the frond pivots on its own joint on the rachis, and
     because they nest, the motion compounds toward the tip. Rotating
     every leaflet about the frond's root was what made the leaves slide
     off the stem, and animating them individually was what cost 38fps. */
  .frond__joint {
    transform-box: view-box;
    /* Same duration as the stem sway. Running the joints on their own
       clock made the leaves drift in and out of step with the stem. The
       whip comes from the amplitudes compounding, not from a different
       tempo. */
    animation: joint var(--breeze-base) ease-in-out infinite;
    animation-delay: calc(-1 * var(--frond-delay));
  }

  /* The shadow is a duplicate of the frond's own joint chain, offset and
     drawn underneath, running the same animation with the same delay, so
     it moves in lockstep. A CSS drop-shadow filter tracked too, but cost
     33fps: a filter on an animating group is re-rasterised every frame.
     Freezing the shadow's joints was cheaper still and visibly wrong. */

  /* A frond that is nowhere near the screen still cost a compositing
     layer per animated group: 14 fronds x 4 groups, live for the whole
     page, on top of 12 pinned acts. That is what left the lower half
     blank and filling in slowly, because the compositor ran out of room
     for tiles and had to re-raster them on demand. Stopping the
     animation outright releases the layer; animation-play-state: paused
     does NOT, it keeps the layer and only freezes it. */
  .frond--still .frond__pivot,
  .frond--still .frond__joint { animation: none; }

  /* Stopping the sway was not enough. A sleeping frond was still 83 vector
     paths the compositor kept painting, and fourteen of them exhausted the
     tile memory in the lower half of the page: that is what arrived blank
     and filled in as you scrolled. Sleeping now means the frond is not in
     the render tree at all. Verified pixel identical over 58 frames
     scrolling down and back up. */
  .frond--still { display: none; }

  @keyframes joint {
    0%, 100% { transform: rotate(calc(-0.55deg * var(--gust-mult, 1))); }
    50%      { transform: rotate(calc(0.75deg * var(--gust-mult, 1))); }
  }

  @media (prefers-reduced-motion: reduce) {
    .frond__pivot, .frond__joint { animation: none; }
  }

  /* Smaller phones: pull the fronds further off-edge so they frame
     rather than crowd the copy.

     The offsets are anchored to the frond's OWN width here, not left as
     percentages. A percentage top/bottom resolves against the section,
     and a section on a phone is 850 to 1300px tall, so -34% threw the
     frond three or four hundred pixels clear of a panel it is only 300px
     tall itself. The top frond vanished completely and the bottom one
     showed nothing but its tail along the bottom edge, which is why
     every section looked identical on a phone. */
  @media (max-width: 600px) {
    /* ROOT AT THE CORNER, LEAF SWEEPING IN.
       On a desktop the frond is rooted well outside the panel and the
       edge crops it, which is what makes it read as one enormous leaf.
       That crop stops working at phone width, because the frond is wider
       than the panel: the only part still on screen is a band of leaflet
       tips running parallel to each other, which looks like a distorted
       fan rather than a palm. Here each frond is mirrored so its stem
       base sits just outside its corner and the leaf arcs into the
       panel, and it is sized to the screen rather than cropped by it.
       The mirrors are what aim the sweep: the artwork grows up and to
       the right from a root at its lower left, so a top corner needs the
       vertical flip and a right corner needs the horizontal one. */
    .frond {
      --frond-w: min(440px, 108vw);
      width: var(--frond-w);
    }
    .frond--tl {
      transform: scaleY(-1) rotate(14deg);
      top: calc(-0.06 * var(--frond-w)); left: calc(-0.10 * var(--frond-w));
      bottom: auto; right: auto;
    }
    .frond--tr {
      transform: scale(-1, -1) rotate(-14deg);
      top: calc(-0.06 * var(--frond-w)); right: calc(-0.10 * var(--frond-w));
      bottom: auto; left: auto;
    }
    .frond--bl {
      transform: rotate(-14deg);
      bottom: calc(-0.06 * var(--frond-w)); left: calc(-0.10 * var(--frond-w));
      top: auto; right: auto;
    }
    .frond--br {
      transform: scaleX(-1) rotate(14deg);
      bottom: calc(-0.06 * var(--frond-w)); right: calc(-0.10 * var(--frond-w));
      top: auto; left: auto;
    }
  }
</style>
