---
/* Generator only. Renders one rosette so the build can write it out
   as public/marks/succulent-<tone>.svg, which is what the page loads. */
/**
 * A succulent rosette, seen from above.
 *
 * Built the way the plant grows: leaf i sits 137.5 degrees round the
 * stem from leaf i-1 and a little further in, so every leaf lands in
 * the gap between the two before it. The outermost are drawn first and
 * the centre last, which is the order they overlap in, and the inner
 * ones reach past the middle so nothing shows through.
 *
 * Each leaf is a teardrop carrying a gradient down its own length:
 * dark where it meets the middle of the plant, lightening as it runs
 * out, drifting into a partner hue and finishing on a vivid tip. Two
 * narrower copies of the same shape sit inside it, darker rather than
 * lighter, because a succulent leaf cups upward and the hollow reads
 * as shadow from this angle. One soft radial wash over the whole
 * rosette gathers the light toward the centre.
 *
 * Props:
 *   corner  - "tl" | "tr" | "bl" | "br"
 *   scale   - size multiplier
 *   tone    - which colour range
 *   opacity - 0..1
 *   delay   - seconds, to offset its drift
 *   rotate  - extra degrees so no two sit identically
 *   show    - "peek" | "half" | "full", how far onto the page it comes
 */
const {
  corner = 'bl', scale = 1, tone = 'mint',
} = Astro.props;

/* How much of the plant is on the page. Most of them only break the
   edge; one or two come further in where a panel has room. */

const tones = {
  mint:  { lit: '#D6EFE4', fill: '#B8E0D0', dark: '#8FC7B2', shade: '#5E9A83', tip: '#4A8770' },
  deep:  { lit: '#B4DCC9', fill: '#8FC7B2', dark: '#6FAE97', shade: '#4A8770', tip: '#37624F' },
  pale:  { lit: '#EEFBF6', fill: '#D8F0E8', dark: '#B8E0D0', shade: '#8FC7B2', tip: '#6FAE97' },
  sage:  { lit: '#C7D8C4', fill: '#A9C0A6', dark: '#8AA687', shade: '#5F7A5C', tip: '#465C43' },
  blush: { lit: '#F3C8C1', fill: '#E7A69C', dark: '#CE857A', shade: '#9C5B52', tip: '#7A443D' },
  amber: { lit: '#F2D2A5', fill: '#E5B172', dark: '#C9924F', shade: '#946330', tip: '#6F4A24' },
  plum:  { lit: '#D8C6D9', fill: '#BCA3BE', dark: '#9C7F9F', shade: '#6C5470', tip: '#503D53' },
};
const c = tones[tone] || tones.mint;

/* One rosette is never one colour. Each family carries a partner hue
   that comes up strongest on the outer leaves and at the tips, plus a
   little variation leaf to leaf, which is what all her references
   show: greens running into blush, pastels running into gold. */
const partners = { mint: 'blush', deep: 'sage', pale: 'mint', sage: 'amber',
                   blush: 'sage', amber: 'blush', plum: 'mint' };
const a = tones[partners[tone] || 'blush'] || tones.blush;
const uid = 'b' + Math.random().toString(36).slice(2, 8);

/* Continuous colour, so no two neighbouring leaves have to share a
   swatch: four buckets is what made the plant read as one blob. */
function hex(h) {
  /* Accepts a #rrggbb or an rgb() string, because blends get blended
     again: feeding this its own output was turning every leaf black. */
  if (h[0] !== '#') return h.match(/\d+/g).slice(0, 3).map(Number);
  const n = parseInt(h.slice(1), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}
function mix(a, b, t) {
  const A = hex(a), B = hex(b);
  const c = A.map((v, i) => Math.round(v + (B[i] - v) * Math.max(0, Math.min(1, t))));
  return `rgb(${c[0]} ${c[1]} ${c[2]})`;
}

const GOLDEN = Math.PI * (3 - Math.sqrt(5));   // 137.5 degrees, the packing angle
const COUNT = 38;

/* ---- seen from above -------------------------------------------
   Straight down the axis, which is the view every one of these plants
   is photographed from. Nothing foreshortens, nothing has to decide
   whether it is showing a face or an edge, and the spiral does all the
   work: leaf i sits 137.5 degrees round from leaf i-1 and a little
   further in, so it lands in the gap between the two before it. The
   outermost are drawn first and the centre last, which is the order
   they overlap in.                                                */
const RMAX = 168;
const topLeaves = [];
{
  for (let i = 0; i < COUNT; i++) {
    const f = i / (COUNT - 1);              // 0 outermost and oldest
    const th = i * GOLDEN - Math.PI / 2;
    const tipR = RMAX * (1 - 0.80 * f);
    /* Inner leaves reach past the middle and overlap each other,
       which is what closes the hole at the centre. */
    const baseR = Math.max(-11, tipR * 0.13 - 9);
    const hw = tipR * (0.30 + 0.13 * f);
    const ux = Math.cos(th), uy = Math.sin(th);
    const nx = -uy, ny = ux;
    /* The blade, and inside it two narrower copies of the same shape.
       A succulent leaf is domed, not flat: the middle of it catches the
       light and the two edges fall away. Nested insets give that at one
       extra path each, where forty gradients would not be worth it. */
    const M = 13;   // enough for a smooth outline at the size these run
    const shell = (scale, shrink) => {
      const up = [], dn = [];
      for (let k = 0; k <= M; k++) {
        const t = k / M;
        const r = baseR + (tipR - baseR) * t * shrink;
        const w = hw * scale * (Math.pow(t, 0.35) * Math.pow(1 - t, 0.80)) / 0.491;
        up.push([ux * r + nx * w, uy * r + ny * w]);
        dn.push([ux * r - nx * w, uy * r - ny * w]);
      }
      return 'M ' + up.concat(dn.reverse()).map(([x, y]) => `${Math.round(x)} ${Math.round(y)}`).join(' L ') + ' Z';
    };
    const shade = Math.max(0, Math.min(1, 0.30 + 0.62 * f + 0.08 * Math.sin(i * 2.13)));
    topLeaves.push({
      gx1: ux * baseR, gy1: uy * baseR,
      gx2: ux * tipR,  gy2: uy * tipR,
      d: shell(1, 1),
      mid: shell(0.64, 0.88),
      core: shell(0.32, 0.70),
      ridge: `M ${(ux * baseR).toFixed(1)} ${(uy * baseR).toFixed(1)} L ${(ux * tipR * 0.78).toFixed(1)} ${(uy * tipR * 0.78).toFixed(1)}`,
      tip: `M ${(ux * tipR * 0.92 + nx * 2.4).toFixed(1)} ${(uy * tipR * 0.92 + ny * 2.4).toFixed(1)} `
         + `L ${(ux * tipR).toFixed(1)} ${(uy * tipR).toFixed(1)} `
         + `L ${(ux * tipR * 0.90 - nx * 2.4).toFixed(1)} ${(uy * tipR * 0.90 - ny * 2.4).toFixed(1)} Z`,
      fill: mix(shade < 0.5 ? mix(c.shade, c.fill, shade / 0.5) : mix(c.fill, c.lit, (shade - 0.5) / 0.5), c.lit, 0.34),
      edge: shade < 0.5 ? mix(c.tip, c.shade, shade / 0.5) : mix(c.shade, c.dark, (shade - 0.5) / 0.5),
      gloss: mix(c.lit, '#ffffff', 0.25),
      /* A succulent leaf cups upward, so from above the middle of it is
         the DEEP part and reads as shadow, while the rim that curls up
         catches the light. The insets therefore darken inward, not
         lighten: a raised dome was exactly backwards. */
      midCol: shade < 0.5 ? mix(c.tip, c.shade, shade / 0.5) : mix(c.shade, c.dark, (shade - 0.5) / 0.5),
      coreCol: shade < 0.5 ? mix(c.tip, c.shade, (shade / 0.5) * 0.6) : mix(c.tip, c.shade, (shade - 0.5) / 0.5),
      /* Along the leaf: dark where it meets the middle of the plant,
         lightening as it runs out, drifting into the partner hue near
         the end, and a vivid point right at the tip. That run of colour
         is the thing every one of her photos has. */
      gBase: shade < 0.5 ? mix(c.tip, c.shade, shade / 0.5) : mix(c.shade, c.dark, (shade - 0.5) / 0.5),
      gMid:  shade < 0.5 ? mix(c.shade, c.fill, shade / 0.5) : mix(c.fill, c.lit, (shade - 0.5) / 0.5),
      gLate: mix(shade < 0.5 ? mix(c.fill, c.lit, shade / 0.5) : c.lit, a.lit, 0.45),
      gTip:  mix(a.fill, a.dark, 0.35),
      tipCol: mix(a.dark, a.shade, 0.35),
    });
  }
}

---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="-185 -185 370 370" role="presentation" focusable="false">
  <defs>
    <radialGradient id={`${uid}-w`} cx="46%" cy="42%" r="62%">
      <stop offset="0%"   stop-color="#ffffff" stop-opacity="0.16" />
      <stop offset="55%"  stop-color="#ffffff" stop-opacity="0.03" />
      <stop offset="100%" stop-color={c.shade}  stop-opacity="0.14" />
    </radialGradient>
    {topLeaves.map((l, n) => (
      <linearGradient id={`${uid}-l${n}`} gradientUnits="userSpaceOnUse"
                      x1={l.gx1.toFixed(1)} y1={l.gy1.toFixed(1)}
                      x2={l.gx2.toFixed(1)} y2={l.gy2.toFixed(1)}>
        <stop offset="0%"   stop-color={l.gBase} />
        <stop offset="42%"  stop-color={l.gMid} />
        <stop offset="80%"  stop-color={l.gLate} />
        <stop offset="100%" stop-color={l.gTip} />
      </linearGradient>
    ))}
    <clipPath id={`${uid}-c`}>
      {topLeaves.map((l) => <path d={l.d} />)}
    </clipPath>
  </defs>
  {topLeaves.map((l, n) => (
    <g>
      <path d={l.d} fill={`url(#${uid}-l${n})`} stroke={l.edge} stroke-width="1.5" stroke-linejoin="round" />
      <path d={l.mid} fill={l.midCol} opacity="0.28" />
      <path d={l.core} fill={l.coreCol} opacity="0.26" />
      <path d={l.tip} fill={l.tipCol} opacity="0.55" />
    </g>
  ))}
  <rect x="-185" y="-185" width="370" height="370" fill={`url(#${uid}-w)`} clip-path={`url(#${uid}-c)`} />
</svg>
