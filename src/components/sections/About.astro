---
import Fronds from '../Fronds.astro';
const { data } = Astro.props;
const paras = String(data.body ?? '').split(/\n\s*\n/).filter(Boolean);
---
{/* Portrait leads on the left, words to its right, so About does not
    repeat the hero's arrangement. */}
<section class="act act--split act--portrait act--lat-band-bottom" id="about">
  <Fronds corner="tl" scale={2.2} tone="deep" opacity={0.3} delay={1.7} />
  <Fronds corner="bl" scale={3.9} tone="deep" opacity={0.4} delay={0.3} />
  <div class="wrap act__inner">
    <div class="act__figure">
      {data.image && <img class="headshot" src={data.image} alt={data.imageAlt ?? ''} width="426" height="496" loading="lazy" />}
    </div>
    <div class="act__body">
      <h2>{data.heading}</h2>
      {paras.map((para, i) => <p class={i === 0 ? 'lede' : undefined}>{para}</p>)}
      {data.bullets.length > 0 && (
        <ul class="ticks">
          {data.bullets.map((b) => <li>{b}</li>)}
        </ul>
      )}
    </div>
  </div>
</section>
