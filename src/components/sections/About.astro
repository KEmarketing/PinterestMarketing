---
const { data } = Astro.props;
---
<section class="act" id="about">
  <div class="wrap act__inner">
    <h2>{data.heading}</h2>
    {data.image && <img class="headshot" src={data.image} alt={data.imageAlt ?? ''} width="426" height="496" loading="lazy" />}
    <p>{data.body}</p>
    {data.bullets.length > 0 && (
      <ul>
        {data.bullets.map((b) => <li>{b}</li>)}
      </ul>
    )}
  </div>
</section>
