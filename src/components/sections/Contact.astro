---
import { resolveUrl } from '../../utils.mjs';
import { SITE } from '../../site.config.mjs';
const { data } = Astro.props;
/* her email and Facebook page come from Site settings, the one place
   they are kept, so the footer and this box always match */
const email = SITE.email;
const facebook = SITE.facebook;
---
{/* Heading left, the box of ways to reach her on the right, as she asked. */}
<section class="act act--wash act--split act--lat-band-top" id="contact">
  <div class="wrap act__inner">
    <div class="act__lead">
      <h2>{data.heading}</h2>
      {String(data.body ?? '').split(/\n\s*\n/).filter(Boolean).map((para) => (
        <p class="lede">{para}</p>
      ))}
    </div>
    <div class="act__body">
      {/* Her mockup: the box holds the heading, the line, the reply note and
          the two links; the button sits under the box, the box's width. */}
      <div class="reach reach--end">
        {data.boxHeading && <p class="reach__heading">{data.boxHeading}</p>}
        {data.boxBody && <p class="reach__body">{data.boxBody}</p>}
        {data.responseNote && <p class="contact-note">{data.responseNote}</p>}
        <ul class="contact-list">
          {email && (
            <li><a href={`mailto:${email}`}>{email}</a></li>
          )}
          {facebook && (
            <li><a href={facebook}>{SITE.labels.contactFacebook}</a></li>
          )}
        </ul>
      </div>
      <div class="actions contact__actions">
        <a class="btn" href={resolveUrl(data.cta.url)}>{data.cta.label}</a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  /* Kandace asked for the words and the box to sit as one group in the
     middle of the screen, with the box and button lowered so the button
     sits level with her last paragraph, as in her mockup. The words are right aligned, so where
     they actually start depends on how the lines wrap at each size; this
     measures the words and the box as drawn and nudges them into place.
     Desktop only, where the two sit side by side. */
  (function () {
    var s = document.getElementById('contact');
    if (!s) return;
    var inner = s.querySelector('.act__inner');
    var lead = s.querySelector('.act__lead');
    var body = s.querySelector('.act__body');
    var box = s.querySelector('.reach');
    var btn = s.querySelector('.contact__actions .btn');
    if (!inner || !lead || !body || !box) return;
    var wide = window.matchMedia('(min-width: 64rem)');
    function extents() {
      var L = Infinity, T = Infinity, B = -Infinity;
      lead.querySelectorAll('h2, p').forEach(function (el) {
        var r = document.createRange();
        r.selectNodeContents(el);
        Array.prototype.forEach.call(r.getClientRects(), function (q) {
          if (q.width < 1) return;
          L = Math.min(L, q.left); T = Math.min(T, q.top); B = Math.max(B, q.bottom);
        });
      });
      var h2 = lead.querySelector('h2');
      if (h2) B = Math.max(B, h2.getBoundingClientRect().bottom);
      var b = box.getBoundingClientRect();
      var m = getComputedStyle(box).boxShadow.match(/(-?\d+(?:\.\d+)?)px\s+(-?\d+(?:\.\d+)?)px/);
      var shadow = m ? Math.max(0, parseFloat(m[1])) : 0;
      var R = Math.max(b.right + shadow, btn ? btn.getBoundingClientRect().right : 0);
      var bottom = btn ? btn.getBoundingClientRect().bottom : b.bottom;
      /* the last paragraph, which the button sits level with in her mockup */
      var ps = lead.querySelectorAll('p');
      var lastT = Infinity, lastB = -Infinity;
      if (ps.length) {
        var r2 = document.createRange();
        r2.selectNodeContents(ps[ps.length - 1]);
        Array.prototype.forEach.call(r2.getClientRects(), function (q) {
          if (q.width < 1) return;
          lastT = Math.min(lastT, q.top); lastB = Math.max(lastB, q.bottom);
        });
      }
      var bb = btn ? btn.getBoundingClientRect() : b;
      return { L: L, R: R, T: T, B: B, bT: b.top, bB: bottom, lastT: lastT, lastB: lastB, btnT: bb.top, btnB: bb.bottom };
    }
    function fit() {
      inner.style.removeProperty('--contact-x');
      body.style.removeProperty('--contact-y');
      if (!wide.matches) return;
      var x = 0, y = 0;
      for (var i = 0; i < 2; i++) {
        var e = extents();
        if (!isFinite(e.L)) return;
        var sec = s.getBoundingClientRect();
        x += (sec.left + sec.right) / 2 - (e.L + e.R) / 2;
        y += isFinite(e.lastT)
          ? (e.lastT + e.lastB) / 2 - (e.btnT + e.btnB) / 2
          : (e.T + e.B) / 2 - (e.bT + e.bB) / 2;
        inner.style.setProperty('--contact-x', x.toFixed(1) + 'px');
        body.style.setProperty('--contact-y', y.toFixed(1) + 'px');
      }
    }
    fit();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    window.addEventListener('load', fit);
    var t;
    window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(fit, 120); });
  })();
</script>
