---
const { data } = Astro.props;
---
<section class="act act--pin act--split act--lat-band-bottom" id="how-pinterest-works">
  <div class="wrap act__inner">
    <div class="act__lead">
      <h2>{data.heading}</h2>
      <p class="lede">{data.body}</p>
    </div>
    <div class="act__body">
      {data.points.length > 0 && (
        <div class="notes">
          {data.points.map((p) => (
            <div class="note">
              <h3>{p.heading}</h3>
              <p>{p.body}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
