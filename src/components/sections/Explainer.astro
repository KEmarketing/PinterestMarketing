---
/* Three cards rather than three rows of prose. The content is a
   comparison, so it reads faster as three things side by side than as a
   passage, and on a phone it stacks into three cards you can take one
   at a time. */
const { data } = Astro.props;
---
<section class="act act--pin act--explainer act--lat-band-bottom" id="how-pinterest-works">
  <div class="wrap act__inner">
    <div class="act__lead">
      <h2>{data.heading}</h2>
      <p class="lede">{data.body}</p>
    </div>
    <div class="act__body">
      {data.points.length > 0 && (
        <div class="notes">
          {data.points.map((p) => (
            <div class="note">
              <h3>{p.heading}</h3>
              <p>{p.body}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
