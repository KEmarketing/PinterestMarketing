---
import Fronds from '../Fronds.astro';
const { data } = Astro.props;
---
<section class="act act--wash act--split act--flip act--lat-inverse act--lat-edge-right" id="faq">
  <Fronds corner="tl" scale={2.3} tone="deep" opacity={0.3} delay={2.8} />
  <Fronds corner="bl" scale={4.1} tone="deep" opacity={0.46} delay={1.5} />
  <div class="wrap act__inner">
    <div class="act__lead">
      <h2>{data.heading}</h2>
    </div>
    <div class="act__body">
      {data.items.map((f) => (
        <details name="faq">
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
