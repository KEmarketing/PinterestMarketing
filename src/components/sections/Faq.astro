---
const { data } = Astro.props;
---
<section class="act act--wash" id="faq">
  <div class="wrap act__inner">
    <h2>{data.heading}</h2>
    <div style="margin-top:1.5rem">
      {data.items.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
