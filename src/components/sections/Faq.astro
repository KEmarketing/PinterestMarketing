---
import Fronds from '../Fronds.astro';
import { resolveUrl } from '../../utils.mjs';
const { data } = Astro.props;
---
{/* The word on the left, the questions on the right, as she asked. The
    palms moved to the left with the heading so they stay off the
    questions, and the lattice went to the other edge. */}
<section class="act act--wash act--split act--lat-inverse act--lat-edge-right" id="faq">
  <Fronds corner="tl" scale={2.3} tone="deep" opacity={0.3} delay={2.8} />
  <Fronds corner="bl" scale={4.1} tone="deep" opacity={0.46} delay={1.5} />
  <div class="wrap act__inner">
    <div class="act__lead">
      <h2>{data.heading}</h2>
    </div>
    <div class="act__body">
      {data.items.map((f) => (
        <details name="faq">
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
          {f.ctaLabel && (
            <p class="faq__cta"><a class="btn" href={resolveUrl('BOOKING_URL')}>{f.ctaLabel}</a></p>
          )}
        </details>
      ))}
    </div>
  </div>
</section>
