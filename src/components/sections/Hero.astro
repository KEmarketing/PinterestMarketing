---
import Fronds from '../Fronds.astro';
import { resolveUrl, emphasise } from '../../utils.mjs';
const { data } = Astro.props;
/* One CMS textarea, blank line between paragraphs. Keeps the editing
   experience to a single field instead of subheadingA / subheadingB. */
const lede = String(data.subheading ?? '').split(/\n\s*\n/).filter(Boolean);
/* Her mockup sets the two questions apart from the statement around
   them: italic, in the display face, as a pair. A paragraph that ends
   in a question mark is one of those. */
const isAsk = (p) => /\?\s*$/.test(p);
---
<section class="act act--pin act--hero act--lat-edge-left" id="top">
  <Fronds corner="tr" scale={2.3} tone="deep" opacity={0.34} delay={0.0} />
  <Fronds corner="br" scale={4.0} tone="deep" opacity={0.55} delay={1.1} />
  <div class="wrap act__inner">
    <div class="act__lead">
      {/* Her headline opens with a short first line in the deeper ink,
          on a line of its own, then the statement. */}
      <h1>
        {data.headingLead && <span class="h1__lead">{data.headingLead}</span>}
        <span set:html={emphasise(data.heading)} />
      </h1>
      {lede.map((para) => <p class:list={['lede', isAsk(para) && 'lede--ask']}>{para}</p>)}
      <div class="actions">
        <a class="btn" href={resolveUrl(data.cta.url)}>{data.cta.label}</a>
      </div>
    </div>
    {data.image && (
      <div class="act__figure">
        <span class="arch">
          <img class="headshot" src={data.image} alt={data.imageAlt ?? ''} width="426" height="496" fetchpriority="high" decoding="async" />
        </span>
      </div>
    )}
  </div>
</section>
