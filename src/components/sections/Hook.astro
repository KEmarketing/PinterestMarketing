---
import Fronds from '../Fronds.astro';
import { emphasise, blockHtml } from '../../utils.mjs';
const { data } = Astro.props;
---
{/* No body content of its own, so this act goes the other way: one
    oversized statement holding the whole panel. It is the beat that
    stops the page reading as a stack of identical text blocks.

    Centred, with both fronds on the left, because that is what she
    asked for on this screen. */}
<section class="act act--pin act--wash act--statement act--centred act--lat-inverse act--lat-edge-right" id="why-pinterest">
  <Fronds corner="tl" scale={2.1} tone="deep" opacity={0.3} delay={2.0} />
  <Fronds corner="bl" scale={4.2} tone="deep" opacity={0.48} delay={0.6} />
  <div class="wrap act__inner">
    <h2 class="statement" set:html={emphasise(data.heading)} />
    {data.sub && <p class="statement__sub">{data.sub}</p>}
    <p class="statement__body" set:html={blockHtml(data.body)} />
    {data.bullets.length > 0 && (
      <ul class="statement__list">
        {/* A hyphenated word (long-term) never splits across the two lines
            of a strip on a phone. */}
        {data.bullets.map((b) => (
          <li>{String(b).split(/(\S+-\S+)/).map((part) => /\S+-\S+/.test(part) ? <span class="nobreak">{part}</span> : part)}</li>
        ))}
      </ul>
    )}
  </div>
</section>
