---
import { resolveUrl } from '../../utils.mjs';
const { data, bookingLabel } = Astro.props;
/* Each line of the note is its own line on the page, so the second
   sentence starts fresh instead of leaving one word stranded. */
const noteLines = String(data.note ?? '').split(/\n+/).map((l) => l.trim()).filter(Boolean);
---
<section class="act act--wide" id="packages">
  <div class="wrap act__inner">
    <div class="act__lead act__lead--row">
      <h2>{data.heading}</h2>
      {data.intro && <p class="lede">{data.intro}</p>}
    </div>

    <p class="swipe-cue">
      <span>Swipe for all options</span>
      <span class="swipe-cue__arrow" aria-hidden="true">&rarr;</span>
    </p>

    <div class="stack" role="region" aria-label="Packages" tabindex="0">
      {data.items.map((p) => (
        <article class:list={['block', p.featured && 'block--featured', p.featured && p.tabTone === 'coral' && 'block--featured-coral', p.tab && 'block--tabbed']}>
          {p.tab && <span class:list={['block__tab', p.tabTone === 'coral' && 'block__tab--coral']}>{p.tab}</span>}
          <h3>{p.name}</h3>
          <p class="price">
            <span class="price__amount">{p.price}</span>
            {p.cadence && <span class="cadence"> {p.cadence}</span>}
          </p>
          {p.summary && <p>{p.summary}</p>}
          <ul>
            {p.features.map((f) => <li>{f}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="packages__cta">
      <a class="btn" href={resolveUrl('BOOKING_URL')}>{data.ctaLabel ?? bookingLabel}</a>
    </div>

    {noteLines.length > 0 && (
      <p class="packages__note">
        {noteLines.map((l) => <span class="packages__note-line">{l}</span>)}
      </p>
    )}
  </div>
</section>
