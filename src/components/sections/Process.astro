---
const { data } = Astro.props;
---
<section class="act act--split act--flip act--lat-edge-right" id="how-it-works">
  <div class="wrap act__inner">
    <div class="act__lead">
      <h2>{data.heading}</h2>
    </div>
    <div class="act__body">
      <ol class="steps">
        {data.steps.map((s) => (
          <li>
            <h3>{s.heading}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
