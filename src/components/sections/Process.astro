---
/* Three steps as cards rather than a column of text, which is how she
   asked for it and which reads as a sequence rather than a passage.
   Full width, so the cards get room to sit side by side. */
import { resolveUrl } from '../../utils.mjs';
const { data } = Astro.props;
---
<section class="act act--steps act--lat-edge-right" id="how-it-works">
  <div class="wrap act__inner">
    <div class="act__lead">
      <h2>{data.heading}</h2>
      {data.aside && <p class="act__aside-note">{data.aside}</p>}
    </div>
    <div class="act__body">
      <ol class="stepcards">
        {data.steps.map((s, i) => (
          <li class="stepcard">
            <span class="stepcard__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="stepcard__box">
              <h3>{s.heading}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      {data.ctaLabel && (
        <div class="steps__cta">
          <a class="btn" href={resolveUrl('BOOKING_URL')}>{data.ctaLabel}</a>
        </div>
      )}
    </div>
  </div>
</section>
