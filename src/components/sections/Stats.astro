---
import Fronds from '../Fronds.astro';
import { emphasise } from '../../utils.mjs';
const { data } = Astro.props;
/* Her simplified mockup: the heading, a navy band of three figures that
   runs the full width of the screen, one big coral figure with its line
   beside it, and a short paragraph. */
const band = data.items ?? [];
const hl = data.highlight;
---
<section class="act act--stats act--lat-edge-left" id="pinterest-stats">
  <Fronds corner="tr" scale={2.2} tone="deep" opacity={0.28} delay={1.2} />
  <Fronds corner="br" scale={3.8} tone="deep" opacity={0.42} delay={2.4} />
  <div class="wrap act__inner">
    <h2 set:html={emphasise(data.heading)} />
  </div>
  {band.length > 0 && (
    <div class="stats__band">
      <div class="wrap">
        <ul class="stats stats--top">
          {band.map((s) => (
            <li class="stat">
              <span class="stat__value">{s.value}</span>
              <span class="stat__label">{s.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}
  <div class="wrap act__inner act__inner--after-band">
    {hl?.value && (
      <p class="stats__highlight">
        <span class="stats__highlight-value">{hl.value}</span>
        {hl.label && <span class="stats__highlight-label">{hl.label}</span>}
      </p>
    )}
    {data.body && <p class="stats__note" set:html={emphasise(data.body)} />}
  </div>
</section>
