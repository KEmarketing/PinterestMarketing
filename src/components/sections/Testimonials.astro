---
/* The reviews are a scrolling row rather than a grid, so the section
   stays one clean line whether there are two of them or ten. */
import Fronds from '../Fronds.astro';
const { data } = Astro.props;
---
<section class="act act--wash act--testimonials act--lat-edge-right" id="testimonials">
  <Fronds corner="tl" scale={3.9} tone="deep" opacity={0.44} delay={0.9} />
  <Fronds corner="bl" scale={2.2} tone="deep" opacity={0.28} delay={2.2} />
  <div class="wrap act__inner">
    <div class="act__lead">
      <h2>{data.heading}</h2>
    </div>
  </div>
  <div class="quotes" role="region" aria-label="Client reviews" tabindex="0">
    {data.items.map((t) => (
      <blockquote>
        <p>{t.quote}</p>
        <footer class="quote-by">
          {t.image && (
            <img class="avatar" src={t.image} alt={t.imageAlt ?? ''} width="72" height="72" loading="lazy" />
          )}
          <cite>{t.name}{t.role && `, ${t.role}`}</cite>
        </footer>
      </blockquote>
    ))}
  </div>
  <div class="wrap">
    <p class="swipe-cue">
      <span>Scroll to see more</span>
      <span class="swipe-cue__arrow" aria-hidden="true">&rarr;</span>
    </p>
  </div>
</section>
