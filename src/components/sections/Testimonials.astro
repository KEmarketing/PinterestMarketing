---
const { data } = Astro.props;
---
<section class="act act--wash" id="testimonials">
  <div class="wrap act__inner">
    <h2>{data.heading}</h2>
    <div class="grid grid--2" style="margin-top:1.5rem">
      {data.items.map((t) => (
        <blockquote>
          <p>{t.quote}</p>
          <footer class="quote-by">
            {t.image && (
              <img class="avatar" src={t.image} alt={t.imageAlt ?? ''} width="72" height="72" loading="lazy" />
            )}
            <cite>{t.name}{t.role && `, ${t.role}`}</cite>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>
