---
/* Her pin designs are the only proof she has, so this act is the one
   that owns its whole screen. Full bleed, staggered, and big: on a
   phone it is a swipe, which is also how Pinterest itself is read. */
const { data } = Astro.props;
---
<section class="act act--showcase act--lat-ends" id="pin-examples">
  <div class="wrap act__inner">
    <h2>{data.heading}</h2>
  </div>
  {/* Her mockup runs the intro line through a mint band the full width
      of the screen, and rules the strip above and below in the same mint. */}
  {data.intro && (
    <div class="showcase__band">
      <div class="wrap"><p class="lede">{data.intro}</p></div>
    </div>
  )}
  <div class="strip" role="region" aria-label="Pin design examples" tabindex="0">
    {data.images.map((img, i) => (
      <figure class="pin" style={`--i:${i}`}>
        <img src={img.src} alt={img.alt} width="400" height="600" loading="lazy" />
      </figure>
    ))}
  </div>
  <div class="wrap">
    <div class="strip-nav">
      <p class="swipe-cue">
        <span>Scroll to see more</span>
        <span class="swipe-cue__arrow" aria-hidden="true">&rarr;</span>
      </p>
      {/* A mouse wheel only scrolls up and down, so on a desktop without
          a trackpad there was no way to move the row. These do it. */}
      <div class="strip-nav__buttons">
        <button class="strip-nav__btn" type="button" data-strip-dir="-1" aria-label="Show earlier pin designs">&larr;</button>
        <button class="strip-nav__btn" type="button" data-strip-dir="1" aria-label="Show more pin designs">&rarr;</button>
      </div>
    </div>
  </div>
</section>
