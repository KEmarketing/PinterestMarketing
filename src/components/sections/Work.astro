---
/* Her pin designs are the only proof she has, so this act is the one
   that owns its whole screen. Full bleed, staggered, and big: on a
   phone it is a swipe, which is also how Pinterest itself is read. */
const { data } = Astro.props;
---
<section class="act act--showcase act--lat-band-top" id="pin-examples">
  <div class="wrap act__inner">
    <h2>{data.heading}</h2>
    {data.intro && <p class="lede">{data.intro}</p>}
  </div>
  <div class="strip" role="region" aria-label="Pin design examples" tabindex="0">
    {data.images.map((img, i) => (
      <figure class="pin" style={`--i:${i}`}>
        <img src={img.src} alt={img.alt} width="400" height="600" loading="lazy" />
      </figure>
    ))}
  </div>
  <div class="wrap">
    <p class="swipe-cue">
      <span>Scroll to see more</span>
      <span class="swipe-cue__arrow" aria-hidden="true">&rarr;</span>
    </p>
  </div>
</section>
