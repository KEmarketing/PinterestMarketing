---
import FrondShapes from '../components/FrondShapes.astro';
import { SITE } from '../site.config.mjs';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/components.css';

const { title, description, page, path = '/' } = Astro.props;
const canonical = new URL(path, SITE.url).href;

/* The email list. One switch in the CMS shows or hides both buttons
   (this one and the one on the last screen). With the switch on and no
   link pasted in yet, this button scrolls to the email list screen at
   the bottom of the page; once there is a link it opens that instead. */
const signup = page?.signup ?? {};
const signupOn = signup.show !== false;
const signupUrl = String(signup.url ?? '').trim();
const signupHref = signupUrl || '#book';
const signupAttrs = signupUrl ? { target: '_blank', rel: 'noopener' } : {};
const signupHeaderLabel = String(signup.headerLabel ?? '').trim() || 'Join my email list';

/* ---------------------------------------------------------------
   Structured data. This is the bulk of the AEO/GEO work: answer
   engines lean on it heavily, and it costs nothing to serve.
   Built from the same content fields the CMS edits, so it can
   never drift out of sync with what is on the page.
   --------------------------------------------------------------- */

const person = {
  '@type': 'Person',
  '@id': `${SITE.url}/#kandace`,
  name: 'Kandace Emory',
  jobTitle: 'Pinterest Marketing Manager',
  email: SITE.email,
  sameAs: [SITE.facebook],
  url: SITE.url,
};

const services = (page?.packages?.items ?? []).map((p) => ({
  '@type': 'Service',
  name: p.name,
  provider: { '@id': `${SITE.url}/#business` },
  serviceType: 'Pinterest marketing',
  offers: {
    '@type': 'Offer',
    price: String(p.price).replace(/[^0-9.]/g, ''),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    description: p.cadence ? `${p.price} ${p.cadence}` : p.price,
  },
}));

const reviews = (page?.testimonials?.items ?? [])
  .filter((t) => !t.quote.startsWith('PLACEHOLDER'))
  .map((t) => ({
    '@type': 'Review',
    reviewBody: t.quote,
    author: { '@type': 'Person', name: t.name },
    itemReviewed: { '@id': `${SITE.url}/#business` },
  }));

const faqs = (page?.faq?.items ?? [])
  .filter((f) => !f.question.startsWith('PLACEHOLDER'))
  .map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  }));

const graph = [
  person,
  {
    '@type': 'ProfessionalService',
    '@id': `${SITE.url}/#business`,
    name: SITE.name,
    description,
    url: SITE.url,
    email: SITE.email,
    founder: { '@id': `${SITE.url}/#kandace` },
    areaServed: { '@type': 'Country', name: 'United States' },
    address: { '@type': 'PostalAddress', addressRegion: SITE.region, addressCountry: SITE.country },
    sameAs: [SITE.facebook],
    ...(reviews.length ? { review: reviews } : {}),
  },
  ...services,
  {
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#business` },
  },
];

if (faqs.length) {
  graph.push({ '@type': 'FAQPage', mainEntity: faqs });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/cormorant-garamond.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <FrondShapes />
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__bar">
        {/* Her layout: three links, the logo in the middle, two links and
            the email list button. The logo is first in the markup so it
            leads on a phone, where the bar stacks. */}
        <a class="wordmark" href="/" aria-label={`${SITE.name}, back to top`}>
          <img class="wordmark__mark" src="/marks/logo-ke-horizontal-navy.webp" alt={SITE.name} width="922" height="143" />
        </a>

        <nav class="site-nav site-nav--left" aria-label="Sections of this page">
          <a href="#how-pinterest-works">Why Pinterest</a>
          <a href="#packages">Services</a>
          <a href="#pin-examples">Portfolio</a>
        </nav>

        <nav class="site-nav site-nav--right" aria-label="More sections of this page">
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
          {signupOn && (
            <a class="site-nav__join" href={signupHref} {...signupAttrs}>{signupHeaderLabel}</a>
          )}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <script is:inline>
      /* Every act pins, on every screen size.

         A sticky act taller than the viewport would normally hide
         its own bottom: it locks at top:0 and the next act rises
         over the part you never got to read. Sticking it to the
         BOTTOM instead fixes that. It scrolls up normally until its
         last line reaches the bottom of the screen, then it holds
         there while the next act covers it. Nothing is unreachable
         and the pinned rhythm survives on a phone.

         The offset has to be measured, because a percentage in
         `top` resolves against the parent, not the element. */
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        var acts = document.querySelectorAll('.act');
        var header = document.querySelector('.site-header');

        /* The header is frozen at the top now, so every act has to pin
           BELOW it rather than at 0, or the header sits over the first
           hundred pixels of whatever is holding. Its height is fluid
           (it wraps to two rows on a phone) so it is measured, published
           as --header-h for the stylesheet, and re-measured on resize. */
        function fit() {
          var hh = header ? header.offsetHeight : 0;
          document.documentElement.style.setProperty('--header-h', hh + 'px');
          var avail = window.innerHeight - hh;
          for (var i = 0; i < acts.length; i++) {
            var a = acts[i];
            a.style.top = '';
            if (reduce.matches) continue;
            /* A tall act still sticks by its BOTTOM: top is pulled up by
               the overshoot so its last line lands on the bottom edge. */
            var overshoot = a.offsetHeight - avail;
            a.style.top = overshoot > 0 ? (hh - overshoot) + 'px' : hh + 'px';
          }
        }

        fit();

        /* An act's height is not fixed: the webfonts swap in, the pin
           images decode, and opening an FAQ answer grows that section
           after load. A stale measurement would push its bottom back
           off the screen, so watch the acts themselves rather than
           measuring once. */
        if (window.ResizeObserver) {
          var ro = new ResizeObserver(function () { fit(); });
          for (var j = 0; j < acts.length; j++) ro.observe(acts[j]);
        } else {
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
          window.addEventListener('load', fit);
          document.addEventListener('toggle', fit, true);
        }

        var t;
        window.addEventListener('resize', function () {
          clearTimeout(t); t = setTimeout(fit, 150);
        });
        if (reduce.addEventListener) reduce.addEventListener('change', fit);
      })();

      /* Park the fronds that are off screen.

         Every frond animates four nested groups, and each running
         animation is its own compositing layer for as long as it runs,
         whether or not it is anywhere near the viewport. Fourteen
         fronds plus twelve pinned acts put the layer tree past what the
         compositor will hold, so it dropped tiles and re-rastered them
         when they were scrolled to: the lower half of the page arriving
         blank and filling in.

         The margin is deliberately wide. A frond restarts in motion
         rather than from a standstill, so the switch happens well
         outside anything that is on screen. */
      (function () {
        var acts = [].slice.call(document.querySelectorAll('.act'));
        if (!acts.length) return;
        var groups = acts.map(function (a) { return a.querySelectorAll('.frond'); });

        /* Which fronds are worth drawing.

           Every act is sticky at top 0 inside one container, so an act you
           have scrolled past does not leave: it stays pinned behind the
           ones after it, all the way down. That makes "touches the
           viewport" true for nearly every act by the time you reach the
           bottom, so an IntersectionObserver keeps waking fronds nobody can
           see. Only the last act to have reached the screen is visible; the
           ones before it sit behind opaque panels.

           So find that act, keep it and one either side awake for the
           handover and for scrolling back up, and let the rest stop
           rendering. Fourteen fronds of vector art drop to about four, and
           the count stays flat instead of climbing as you go down. */
        var ticking = false;
        function apply() {
          ticking = false;
          var vh = window.innerHeight, active = 0;
          for (var i = 0; i < acts.length; i++) {
            if (acts[i].getBoundingClientRect().top <= vh * 0.9) active = i;
          }
          for (var j = 0; j < acts.length; j++) {
            var awake = j >= active - 1 && j <= active + 1;
            var f = groups[j];
            for (var k = 0; k < f.length; k++) f[k].classList.toggle('frond--still', !awake);
          }
        }
        function schedule() { if (!ticking) { ticking = true; requestAnimationFrame(apply); } }
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(apply);
        apply();
      })();
    </script>

    <script is:inline>
      /* Flag any act whose scrolling row is wider than the space it has, so
         the swipe cue appears exactly when there is something to scroll to.
         The number of pins and packages is editable in the CMS, so it is not
         something the stylesheet can assume from the viewport width. */
      (function () {
        var rows = document.querySelectorAll('.strip, #packages .stack, #testimonials .quotes');
        if (!rows.length) return;
        function check() {
          for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var act = row.closest('.act');
            if (!act) continue;
            act.classList.toggle('act--overflowing', row.scrollWidth > row.clientWidth + 4);
          }
        }
        check();
        window.addEventListener('resize', check);
        window.addEventListener('load', check);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(check);
      })();
    </script>

    <script is:inline>
      /* Moving a sideways row with a mouse. A wheel scrolls the page, not
         the row, and the row hides its scrollbar, so on a desktop with a
         plain mouse the pins past the edge could not be reached at all.
         The two arrows under the row move it most of a screen at a time,
         and the row can be dragged. Touch and trackpads are untouched. */
      (function () {
        var buttons = document.querySelectorAll('.strip-nav__btn');
        for (var i = 0; i < buttons.length; i++) {
          (function (btn) {
            var act = btn.closest('.act');
            var row = act && act.querySelector('.strip');
            if (!row) return;
            var dir = Number(btn.getAttribute('data-strip-dir')) || 1;
            btn.addEventListener('click', function () {
              row.scrollBy({ left: dir * row.clientWidth * 0.7, behavior: 'smooth' });
            });
            function state() {
              var max = row.scrollWidth - row.clientWidth;
              btn.disabled = dir < 0 ? row.scrollLeft <= 2 : row.scrollLeft >= max - 2;
            }
            row.addEventListener('scroll', state, { passive: true });
            window.addEventListener('resize', state);
            window.addEventListener('load', state);
            state();
          })(buttons[i]);
        }

        var rows = document.querySelectorAll('.strip');
        for (var j = 0; j < rows.length; j++) {
          (function (row) {
            var startX = 0, startLeft = 0, down = false;
            row.addEventListener('pointerdown', function (e) {
              if (e.pointerType !== 'mouse' || e.button !== 0) return;
              if (row.scrollWidth <= row.clientWidth + 4) return;
              down = true; startX = e.clientX; startLeft = row.scrollLeft;
            });
            window.addEventListener('pointermove', function (e) {
              if (!down) return;
              var dx = e.clientX - startX;
              if (Math.abs(dx) > 3) row.classList.add('is-dragging');
              row.scrollLeft = startLeft - dx;
            });
            function end() { down = false; row.classList.remove('is-dragging'); }
            window.addEventListener('pointerup', end);
            window.addEventListener('pointercancel', end);
          })(rows[j]);
        }
      })();
    </script>

    <script is:inline>
      /* The FAQ is an exclusive accordion so the section can never grow
         past the screen. Current browsers do that natively from the name
         attribute on each details element; this only steps in where that
         is not supported, so nothing runs twice. */
      (function () {
        if ('name' in document.createElement('details')) return;
        var items = document.querySelectorAll('#faq details');
        for (var i = 0; i < items.length; i++) {
          items[i].addEventListener('toggle', function () {
            if (!this.open) return;
            for (var j = 0; j < items.length; j++) {
              if (items[j] !== this) items[j].open = false;
            }
          });
        }
      })();
    </script>

    <script is:inline>
      /* No word left alone on a line. The last two words of every heading,
         paragraph, list item, button and short line are held together so a
         line never ends with one stranded word. Each change is measured: if
         holding the pair together strands a different word on the line
         above, the element is put back the way it was. Runs once, before
         first paint, on the text as served. */
      (function () {
        var SEL = 'h1, h2, h3, h4, p, li, dd, dt, blockquote, figcaption, summary, .btn, .chapter__sub-line, .packages__note-line, .stat__label, .stat__note';
        var SP = /[ \t\n\r]/;
        function textNodes(el) {
          var w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT), out = [], n;
          while ((n = w.nextNode())) out.push(n);
          return out;
        }
        /* How many lines of this element hold a single word. */
        function lonely(el) {
          var r = document.createRange(), rows = {}, nodes = textNodes(el);
          for (var i = 0; i < nodes.length; i++) {
            var t = nodes[i].nodeValue, re = /\S+/g, m;
            while ((m = re.exec(t))) {
              r.setStart(nodes[i], m.index); r.setEnd(nodes[i], m.index + m[0].length);
              var rects = r.getClientRects();
              if (!rects.length) continue;
              var y = Math.round(rects[rects.length - 1].top / 4);
              rows[y] = (rows[y] || 0) + 1;
            }
          }
          var count = 0, lines = 0;
          for (var k in rows) { lines++; if (rows[k] === 1) count++; }
          return lines > 1 ? count : 0;
        }
        /* Hold the last two words together; returns a function that puts
           the element back, or null when there was nothing to do. */
        function tie(el) {
          var nodes = textNodes(el), seenWord = false;
          /* Inside a flex or grid box a wrapping span would become a box
             of its own, so there the pair is tied with a no-break space. */
          var d = getComputedStyle(el).display, boxy = /flex|grid/.test(d);
          for (var k = nodes.length - 1; k >= 0; k--) {
            var node = nodes[k], t = node.nodeValue;
            for (var c = t.length - 1; c >= 0; c--) {
              if (!SP.test(t.charAt(c))) { seenWord = true; continue; }
              if (!seenWord) continue;
              if (c > 0 && !SP.test(t.charAt(c - 1)) && boxy) {
                node.nodeValue = t.slice(0, c) + '\u00A0' + t.slice(c + 1);
                return function () { node.nodeValue = t; };
              }
              if (c > 0 && !SP.test(t.charAt(c - 1))) {
                /* Both words live in this node: wrap the pair so it cannot
                   break, not even at a hyphen. */
                var s0 = c - 1;
                while (s0 > 0 && !SP.test(t.charAt(s0 - 1))) s0--;
                var span = document.createElement('span');
                span.style.whiteSpace = 'nowrap';
                span.appendChild(document.createTextNode(t.slice(s0)));
                node.nodeValue = t.slice(0, s0);
                node.parentNode.insertBefore(span, node.nextSibling);
                return function () { span.parentNode.removeChild(span); node.nodeValue = t; };
              }
              if (c === 0) {
                /* The space opens this node; the word before it is in an
                   earlier node, so tie across the boundary. */
                node.nodeValue = ' ' + t.slice(1);
                return function () { node.nodeValue = t; };
              }
              return null;
            }
          }
          return null;
        }
        /* All the writes first, then all the reads, so the page lays out
           three times in total rather than once per element. */
        var els = document.querySelectorAll(SEL), tied = [];
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          if (el.querySelector('h1, h2, h3, h4, p, li, ul, ol')) continue;
          if (el.textContent.replace(/\s+/g, ' ').trim().split(' ').length < 4) continue;
          var undo = tie(el);
          if (undo) tied.push({ el: el, undo: undo, after: 0 });
        }
        var suspect = [];
        for (var a = 0; a < tied.length; a++) {
          tied[a].after = lonely(tied[a].el);
          if (tied[a].after) suspect.push(tied[a]);
        }
        for (var b = 0; b < suspect.length; b++) suspect[b].undo();
        /* Holding the pair stranded a word higher up. Keep the natural
           wrap unless it is worse. */
        var retie = [];
        for (var c2 = 0; c2 < suspect.length; c2++) {
          if (lonely(suspect[c2].el) > suspect[c2].after) retie.push(suspect[c2].el);
        }
        for (var d2 = 0; d2 < retie.length; d2++) tie(retie[d2]);
      })();
    </script>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="site-footer__brand">
          {/* Her stacked wordmark, which already carries the name, so there
              is no typeset name beside it. */}
          <img class="site-footer__wordmark" src="/marks/logo-ke-wordmark.webp" alt={SITE.name} width="536" height="206" loading="lazy" />
        </div>

        <nav class="site-footer__nav" aria-label="Sections of this page, footer">
          <a href="#how-pinterest-works">Why Pinterest</a>
          <a href="#packages">Services</a>
          <a href="#pin-examples">Portfolio</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>

        <ul class="site-footer__reach">
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.facebook}>Facebook</a></li>
        </ul>
      </div>

      <div class="wrap site-footer__fine">
        <p>Not affiliated with or endorsed by Pinterest. Results vary and are not guaranteed.</p>
        <p>&copy; {new Date().getFullYear()} {SITE.name} &middot; Built with love by <a href="https://rootlineweb.co" rel="noopener">Rootline Web Co</a></p>
      </div>
    </footer>
  </body>
</html>
