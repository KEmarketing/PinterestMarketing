---
import { SITE } from '../site.config.mjs';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/components.css';

const { title, description, page, path = '/' } = Astro.props;
const canonical = new URL(path, SITE.url).href;

/* ---------------------------------------------------------------
   Structured data. This is the bulk of the AEO/GEO work: answer
   engines lean on it heavily, and it costs nothing to serve.
   Built from the same content fields the CMS edits, so it can
   never drift out of sync with what is on the page.
   --------------------------------------------------------------- */

const person = {
  '@type': 'Person',
  '@id': `${SITE.url}/#kandace`,
  name: 'Kandace Emory',
  jobTitle: 'Pinterest Marketing Manager',
  email: SITE.email,
  sameAs: [SITE.facebook],
  url: SITE.url,
};

const services = (page?.packages?.items ?? []).map((p) => ({
  '@type': 'Service',
  name: p.name,
  provider: { '@id': `${SITE.url}/#business` },
  serviceType: 'Pinterest marketing',
  offers: {
    '@type': 'Offer',
    price: String(p.price).replace(/[^0-9.]/g, ''),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    description: p.cadence ? `${p.price} ${p.cadence}` : p.price,
  },
}));

const reviews = (page?.testimonials?.items ?? [])
  .filter((t) => !t.quote.startsWith('PLACEHOLDER'))
  .map((t) => ({
    '@type': 'Review',
    reviewBody: t.quote,
    author: { '@type': 'Person', name: t.name },
    itemReviewed: { '@id': `${SITE.url}/#business` },
  }));

const faqs = (page?.faq?.items ?? [])
  .filter((f) => !f.question.startsWith('PLACEHOLDER'))
  .map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  }));

const graph = [
  person,
  {
    '@type': 'ProfessionalService',
    '@id': `${SITE.url}/#business`,
    name: SITE.name,
    description,
    url: SITE.url,
    email: SITE.email,
    founder: { '@id': `${SITE.url}/#kandace` },
    areaServed: { '@type': 'Country', name: 'United States' },
    address: { '@type': 'PostalAddress', addressRegion: SITE.region, addressCountry: SITE.country },
    sameAs: [SITE.facebook],
    ...(reviews.length ? { review: reviews } : {}),
  },
  ...services,
  {
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: title,
    description,
    isPartOf: { '@id': `${SITE.url}/#business` },
  },
];

if (faqs.length) {
  graph.push({ '@type': 'FAQPage', mainEntity: faqs });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/cormorant-garamond.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        {/* Her actual logo, lifted off its white background so the paper
            shows through. It already contains her name, so there is no
            wordmark set beside it: the accessible name carries it instead. */}
        <a class="wordmark" href="/" aria-label={`${SITE.name}, back to top`}>
          <img class="wordmark__mark" src="/marks/logo-ke.webp" alt={SITE.name} width="256" height="256" />
        </a>

        <nav class="site-nav" aria-label="Sections of this page">
          <a href="#how-pinterest-works">Why Pinterest</a>
          <a href="#packages">Services</a>
          <a href="#pin-examples">Portfolio</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <script is:inline>
      /* Every act pins, on every screen size.

         A sticky act taller than the viewport would normally hide
         its own bottom: it locks at top:0 and the next act rises
         over the part you never got to read. Sticking it to the
         BOTTOM instead fixes that. It scrolls up normally until its
         last line reaches the bottom of the screen, then it holds
         there while the next act covers it. Nothing is unreachable
         and the pinned rhythm survives on a phone.

         The offset has to be measured, because a percentage in
         `top` resolves against the parent, not the element. */
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        var acts = document.querySelectorAll('.act');

        function fit() {
          for (var i = 0; i < acts.length; i++) {
            var a = acts[i];
            a.style.top = '';
            if (reduce.matches) continue;
            var overshoot = a.offsetHeight - window.innerHeight;
            a.style.top = overshoot > 0 ? (-overshoot) + 'px' : '0px';
          }
        }

        fit();

        /* An act's height is not fixed: the webfonts swap in, the pin
           images decode, and opening an FAQ answer grows that section
           after load. A stale measurement would push its bottom back
           off the screen, so watch the acts themselves rather than
           measuring once. */
        if (window.ResizeObserver) {
          var ro = new ResizeObserver(function () { fit(); });
          for (var j = 0; j < acts.length; j++) ro.observe(acts[j]);
        } else {
          if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
          window.addEventListener('load', fit);
          document.addEventListener('toggle', fit, true);
        }

        var t;
        window.addEventListener('resize', function () {
          clearTimeout(t); t = setTimeout(fit, 150);
        });
        if (reduce.addEventListener) reduce.addEventListener('change', fit);
      })();

      /* Park the fronds that are off screen.

         Every frond animates four nested groups, and each running
         animation is its own compositing layer for as long as it runs,
         whether or not it is anywhere near the viewport. Fourteen
         fronds plus twelve pinned acts put the layer tree past what the
         compositor will hold, so it dropped tiles and re-rastered them
         when they were scrolled to: the lower half of the page arriving
         blank and filling in.

         The margin is deliberately wide. A frond restarts in motion
         rather than from a standstill, so the switch happens well
         outside anything that is on screen. */
      (function () {
        var acts = [].slice.call(document.querySelectorAll('.act'));
        if (!acts.length) return;
        var groups = acts.map(function (a) { return a.querySelectorAll('.frond'); });

        /* Which fronds are worth drawing.

           Every act is sticky at top 0 inside one container, so an act you
           have scrolled past does not leave: it stays pinned behind the
           ones after it, all the way down. That makes "touches the
           viewport" true for nearly every act by the time you reach the
           bottom, so an IntersectionObserver keeps waking fronds nobody can
           see. Only the last act to have reached the screen is visible; the
           ones before it sit behind opaque panels.

           So find that act, keep it and one either side awake for the
           handover and for scrolling back up, and let the rest stop
           rendering. Fourteen fronds of vector art drop to about four, and
           the count stays flat instead of climbing as you go down. */
        var ticking = false;
        function apply() {
          ticking = false;
          var vh = window.innerHeight, active = 0;
          for (var i = 0; i < acts.length; i++) {
            if (acts[i].getBoundingClientRect().top <= vh * 0.9) active = i;
          }
          for (var j = 0; j < acts.length; j++) {
            var awake = j >= active - 1 && j <= active + 1;
            var f = groups[j];
            for (var k = 0; k < f.length; k++) f[k].classList.toggle('frond--still', !awake);
          }
        }
        function schedule() { if (!ticking) { ticking = true; requestAnimationFrame(apply); } }
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(apply);
        apply();
      })();
    </script>

    <script is:inline>
      /* Flag any act whose scrolling row is wider than the space it has, so
         the swipe cue appears exactly when there is something to scroll to.
         The number of pins and packages is editable in the CMS, so it is not
         something the stylesheet can assume from the viewport width. */
      (function () {
        var rows = document.querySelectorAll('.strip, #packages .stack');
        if (!rows.length) return;
        function check() {
          for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var act = row.closest('.act');
            if (!act) continue;
            act.classList.toggle('act--overflowing', row.scrollWidth > row.clientWidth + 4);
          }
        }
        check();
        window.addEventListener('resize', check);
        window.addEventListener('load', check);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(check);
      })();
    </script>

    <script is:inline>
      /* The FAQ is an exclusive accordion so the section can never grow
         past the screen. Current browsers do that natively from the name
         attribute on each details element; this only steps in where that
         is not supported, so nothing runs twice. */
      (function () {
        if ('name' in document.createElement('details')) return;
        var items = document.querySelectorAll('#faq details');
        for (var i = 0; i < items.length; i++) {
          items[i].addEventListener('toggle', function () {
            if (!this.open) return;
            for (var j = 0; j < items.length; j++) {
              if (items[j] !== this) items[j].open = false;
            }
          });
        }
      })();
    </script>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div class="site-footer__brand">
          {/* Reversed mark: her navy lines knocked out to paper for the
              dark footer, gold sparkle untouched because it already reads
              on navy. Swap in an official reversed logo if she has one. */}
          <img class="site-footer__mark" src="/marks/logo-ke-light.webp" alt="" width="256" height="256" />
          <p class="site-footer__name">{SITE.name}</p>
        </div>

        <nav class="site-footer__nav" aria-label="Sections of this page">
          <a href="#how-pinterest-works">Why Pinterest</a>
          <a href="#packages">Services</a>
          <a href="#pin-examples">Portfolio</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>

        <ul class="site-footer__reach">
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.facebook}>Facebook</a></li>
        </ul>
      </div>

      <div class="wrap site-footer__fine">
        <p>Not affiliated with or endorsed by Pinterest. Results vary and are not guaranteed.</p>
        <p>&copy; {new Date().getFullYear()} {SITE.name} &middot; Built with love by <a href="https://rootlineweb.co" rel="noopener">Rootline Web Co</a></p>
      </div>
    </footer>
  </body>
</html>
