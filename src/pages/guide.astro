---
/* Kandace's site guide, searchable. The words come from cms/guide.md,
   so there is only ever one copy to keep up to date. This page is just for her: it is
   kept out of search results and out of the sitemap. */
import * as Guide from '../../cms/guide.md';
import { SITE } from '../site.config.mjs';

const sections = Guide.getHeadings().filter((h) => h.depth === 2);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Your site guide | {SITE.name}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="g-top">
      <div class="g-wrap">
        <div class="g-bar">
          <p class="g-title">Your site guide</p>
          <nav class="g-links">
            <a class="g-edit" href="https://app.pagescms.org/kemarketing/pinterestmarketing/main" target="_blank" rel="noopener">Open your editor<span class="g-sr"> (opens in a new tab)</span></a>
            <a href="/">View your site</a>
          </nav>
        </div>
        <label class="g-label" for="g-search">What do you want to change or set up?</label>
        <div class="g-field">
          <input id="g-search" type="search" autocomplete="off" spellcheck="false"
                 placeholder="Try: photo, price, email list" />
          <button type="button" class="g-clear" hidden aria-label="Clear the search">Clear</button>
        </div>
        <p class="g-status" aria-live="polite"></p>
      </div>
    </header>

    <main class="g-wrap">
      <nav class="g-toc" aria-label="Guide sections">
        <p class="g-toc__label">Jump to</p>
        <ul>
          {sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ul>
      </nav>
      <div class="g-best" hidden>
        <p class="g-best__label">Best match</p>
        <ul></ul>
      </div>
      <article id="g-body">
        <Guide.Content />
      </article>
      <p class="g-none" hidden>Nothing matched. Try a simpler word, like <b>photo</b>, <b>button</b>, <b>price</b> or <b>Google</b>.</p>
    </main>

    <style is:global>
      /* Its own copy of her fonts and colors, so this page never changes
         how the main page's styles are bundled. */
      @font-face {
  font-family: 'Cormorant Garamond';
  font-style: normal;
  font-weight: 300 700;
  font-display: swap;
  src: url('/fonts/cormorant-garamond.woff2') format('woff2-variations'),
       url('/fonts/cormorant-garamond.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
                 U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
                 U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
      @font-face {
  font-family: 'Montserrat';
  font-style: normal;
  font-weight: 100 900;
  font-display: swap;
  src: url('/fonts/montserrat.woff2') format('woff2-variations'),
       url('/fonts/montserrat.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6,
                 U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
                 U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
      :root {
        --navy: #455F76; --navy-deep: #33485B; --mint: #BEE2D0; --mint-pale: #DCF0E6;
        --coral: #FFA384; --gold: #EDD776; --blush-pale: #FFE7DE;
        --paper: #FAFCFB; --ink: #22303C; --ink-soft: #5C6B78; --rule: #DFE8E4;
        --font-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
        --font-body: 'Montserrat', system-ui, -apple-system, sans-serif;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-padding-top: 13rem; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--font-body); font-size: 1rem; line-height: 1.65; }
      .g-wrap { width: min(100% - 2rem, 48rem); margin-inline: auto; }
      .g-top { position: sticky; top: 0; z-index: 10; background: var(--navy); color: #fff; padding: 1rem 0 0.75rem; box-shadow: 0 2px 12px rgba(34, 48, 60, 0.18); }
      .g-bar { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; }
      .g-title { margin: 0; font-family: var(--font-display); font-size: 1.9rem; font-weight: 600; line-height: 1.1; }
      .g-links { display: flex; gap: 1rem; font-size: 0.85rem; }
      .g-links { align-items: center; }
      .g-links a { color: #fff; }
      .g-links a.g-edit { background: var(--gold); color: var(--navy-deep); font-weight: 700; text-decoration: none; padding: 0.4rem 0.85rem; border-radius: 999px; }
      .g-links a.g-edit:hover, .g-links a.g-edit:focus-visible { background: #fff; }
      .g-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .g-label { display: block; margin: 0.75rem 0 0.35rem; font-size: 0.9rem; font-weight: 600; }
      .g-field { display: flex; gap: 0.5rem; }
      #g-search { flex: 1; min-width: 0; font: inherit; font-size: 1.05rem; padding: 0.7rem 0.9rem; border: 2px solid var(--mint); border-radius: 0.5rem; background: #fff; color: var(--ink); }
      #g-search:focus { outline: 3px solid var(--gold); outline-offset: 1px; }
      .g-clear { font: inherit; font-size: 0.9rem; font-weight: 600; padding: 0 1rem; border: 0; border-radius: 0.5rem; background: var(--mint); color: var(--navy-deep); cursor: pointer; }
      .g-status { margin: 0.4rem 0 0; min-height: 1.3em; font-size: 0.85rem; color: var(--mint-pale); }
      main.g-wrap { padding: 1.5rem 0 4rem; }
      .g-toc { background: var(--mint-pale); border-radius: 0.75rem; padding: 1rem 1.25rem; margin-bottom: 1.5rem; }
      .g-toc__label { margin: 0 0 0.35rem; font-weight: 700; color: var(--navy); }
      .g-toc ul { margin: 0; padding-left: 1.1rem; columns: 2 14rem; }
      .g-toc a, #g-body a { color: var(--navy); }
      #g-body h1 { display: none; }
      #g-body h2 { font-family: var(--font-display); font-size: 2rem; font-weight: 600; line-height: 1.15; color: var(--navy); margin: 2.25rem 0 0.5rem; padding-top: 1rem; border-top: 2px solid var(--rule); }
      #g-body h3 { font-size: 1.1rem; color: var(--navy-deep); margin: 1.5rem 0 0.35rem; }
      #g-body code { font-size: 0.92em; background: var(--mint-pale); padding: 0.05em 0.35em; border-radius: 0.25rem; }
      #g-body li { margin-bottom: 0.3rem; }
      mark { background: var(--gold); color: var(--ink); border-radius: 0.15rem; padding: 0 0.1em; }
      .g-sec[hidden], .g-toc[hidden] { display: none; }
      .g-none { font-size: 1.05rem; }
      .g-best { background: var(--blush-pale); border-left: 4px solid var(--coral); border-radius: 0.5rem; padding: 0.85rem 1.1rem; margin-bottom: 0.5rem; }
      .g-best[hidden] { display: none; }
      .g-best__label { margin: 0 0 0.25rem; font-weight: 700; color: var(--navy); }
      .g-best ul { margin: 0; padding-left: 1.1rem; }
      .g-best a { color: var(--navy); font-weight: 600; }
      .g-from { margin: 1.75rem 0 -1.25rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); }
      @media (max-width: 40rem) {
        .g-top { padding: 0.6rem 0 0.5rem; }
        .g-bar { align-items: center; }
        .g-title { font-size: 1.3rem; }
        .g-links { font-size: 0.8rem; gap: 0.75rem; }
        .g-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
        .g-field { margin-top: 0.5rem; }
        #g-search { font-size: 1rem; padding: 0.55rem 0.75rem; }
        .g-status { font-size: 0.8rem; }
        html { scroll-padding-top: 9.5rem; }
      }
    </style>

    <script is:inline>
      (function () {
        var body = document.getElementById('g-body');
        var input = document.getElementById('g-search');
        var clear = document.querySelector('.g-clear');
        var status = document.querySelector('.g-status');
        var none = document.querySelector('.g-none');
        var toc = document.querySelector('.g-toc');
        var best = document.querySelector('.g-best');
        var bestList = best.querySelector('ul');

        /* Words she might type that the guide says differently. */
        var alike = [
          ['photo', 'picture', 'image', 'headshot', 'photos', 'pictures', 'images'],
          ['price', 'prices', 'pricing', 'cost', 'package', 'packages'],
          ['button', 'buttons', 'link', 'links'],
          ['email list', 'signup', 'sign up', 'newsletter', 'subscribe', 'mailing list'],
          ['headline', 'heading', 'title', 'header'],
          ['question', 'questions', 'faq'],
          ['testimonial', 'testimonials', 'review', 'reviews'],
          ['google', 'search console', 'seo'],
          ['bing', 'microsoft', 'copilot'],
          ['ai', 'chatgpt', 'perplexity'],
          ['menu', 'nav', 'navigation'],
          ['paragraph', 'paragraphs', 'new line', 'line break', 'enter', 'spacing', 'formatting', 'bold', 'italic'],
          ['booking', 'book', 'calendar', 'call', 'acuity'],
          ['verify', 'verification', 'ownership', 'code', 'claim']
        ];

        /* Split the guide into sections at every h2 and h3, so a search
           shows just the parts that mention what she typed. */
        var secs = [];
        var group = '';
        var current = null;
        Array.prototype.slice.call(body.children).forEach(function (el) {
          if (el.tagName === 'H1') return;
          if (el.tagName === 'H2' || el.tagName === 'H3') {
            if (el.tagName === 'H2') group = el.textContent;
            current = document.createElement('section');
            current.className = 'g-sec';
            current.dataset.group = group;
            current.dataset.level = el.tagName;
            body.insertBefore(current, el);
            secs.push(current);
          }
          if (!current) {
            current = document.createElement('section');
            current.className = 'g-sec';
            current.dataset.group = '';
            body.insertBefore(current, el);
            secs.push(current);
          }
          current.appendChild(el);
        });
        secs.forEach(function (s) {
          s.dataset.text = (s.dataset.group + ' ' + s.textContent).toLowerCase();
          if (s.dataset.level === 'H3') {
            var from = document.createElement('p');
            from.className = 'g-from';
            from.hidden = true;
            from.textContent = s.dataset.group;
            s.insertBefore(from, s.firstChild);
          }
        });

        function unmark() {
          body.querySelectorAll('mark').forEach(function (m) {
            m.replaceWith(document.createTextNode(m.textContent));
          });
          body.normalize();
        }
        function markIn(root, words) {
          var re = new RegExp('(' + words.map(pattern).join('|') + ')', 'gi');
          var walk = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
          var nodes = [];
          while (walk.nextNode()) nodes.push(walk.currentNode);
          nodes.forEach(function (n) {
            if (!re.test(n.nodeValue)) return;
            re.lastIndex = 0;
            var frag = document.createDocumentFragment();
            n.nodeValue.split(re).forEach(function (part, i) {
              if (i % 2) { var m = document.createElement('mark'); m.textContent = part; frag.appendChild(m); }
              else if (part) frag.appendChild(document.createTextNode(part));
            });
            n.parentNode.replaceChild(frag, n);
          });
        }
        /* Everyday words that don't help find anything ("how do I change my..."). */
        var filler = ['a','an','the','my','i','me','to','do','how','can','where','what','is','it','on','in','of','for','and','change','changing','edit','editing','update','updating','fix','want','need','add','adding','new','put','find','make','site','website','page','set','up','setup','get','started','start','use','with','about','your','you','show','shows','see'];

        /* Whole words for short terms, word starts for longer ones, so
           "ai" doesn't match "maintain" but "photo" still finds "photos". */
        function pattern(w) {
          var e = w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
          return w.length <= 3 ? '\\b' + e + '\\b' : '\\b' + e + '[\\w’\']*';
        }
        function has(text, w) { return new RegExp(pattern(w), 'i').test(text); }

        function options(term) {
          for (var i = 0; i < alike.length; i++) {
            if (alike[i].indexOf(term) !== -1) return alike[i];
          }
          return [term];
        }

        function run() {
          var q = input.value.trim().toLowerCase().replace(/\s+/g, ' ');
          unmark();
          clear.hidden = !q;
          if (!q) {
            secs.forEach(function (s) { s.hidden = false; var f = s.querySelector('.g-from'); if (f) f.hidden = true; });
            toc.hidden = false; none.hidden = true; status.textContent = ''; best.hidden = true;
            return;
          }
          /* A known phrase counts as one term; otherwise every word has to appear. */
          var terms = [];
          var phrase = alike.some(function (g) { return g.indexOf(q) !== -1; });
          if (phrase) terms = [q];
          else terms = q.split(' ').filter(function (w) { return w.length > 1 && filler.indexOf(w) === -1; });
          if (!terms.length) terms = q.split(' ').filter(function (w) { return w.length > 1; });
          if (!terms.length) terms = [q];
          /* The intro above the first heading isn't an answer to anything. */
          var searchable = secs.filter(function (s) { return s.dataset.level; });
          function matches(s, mode) {
            return terms[mode](function (t) {
              return options(t).some(function (o) { return has(s.dataset.text, o); });
            });
          }
          /* Sections that mention every word first; if none do, any word. */
          var mode = searchable.some(function (s) { return matches(s, 'every'); }) ? 'every' : 'some';
          var hits = 0;
          var lit = [];
          secs.forEach(function (s) {
            var ok = !!s.dataset.level && matches(s, mode);
            s.hidden = !ok;
            var f = s.querySelector('.g-from'); if (f) f.hidden = !ok;
            if (ok) hits++;
          });
          terms.forEach(function (t) { lit = lit.concat(options(t)); });
          /* Sections whose title itself matches go in a box at the top. */
          bestList.innerHTML = '';
          secs.forEach(function (s) {
            if (s.hidden) return;
            var h = s.querySelector('h2, h3');
            if (!h || !h.id) return;
            var title = h.textContent;
            if (!lit.some(function (o) { return has(title, o); })) return;
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = '#' + h.id;
            a.textContent = (s.dataset.level === 'H3' && s.dataset.group ? s.dataset.group + ': ' : '') + title;
            li.appendChild(a);
            bestList.appendChild(li);
          });
          best.hidden = !bestList.children.length;
          best.querySelector('.g-best__label').textContent = bestList.children.length > 1 ? 'Best matches' : 'Best match';
          secs.forEach(function (s) { if (!s.hidden) markIn(s, lit); });
          toc.hidden = true;
          none.hidden = hits !== 0;
          status.textContent = hits ? (hits === 1 ? '1 part of the guide matches.' : hits + ' parts of the guide match.') : '';
        }

        var t;
        input.addEventListener('input', function () { clearTimeout(t); t = setTimeout(run, 120); });
        clear.addEventListener('click', function () { input.value = ''; run(); input.focus(); });
        document.addEventListener('keydown', function (e) {
          if (e.key === '/' && document.activeElement !== input) { e.preventDefault(); input.focus(); }
          if (e.key === 'Escape' && document.activeElement === input) { input.value = ''; run(); }
        });
        var start = new URLSearchParams(location.search).get('q');
        if (start) { input.value = start; run(); }
      })();
    </script>
  </body>
</html>
